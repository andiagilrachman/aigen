# =============================================================================
#  AIGen Backend — contoh konfigurasi environment
#  Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
#
#  Nama variabel di sini HARUS sama persis dengan yang dibaca config/config.php.
# =============================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/aigen-backend

# Asal frontend yang diizinkan CORS (pisahkan dengan koma, tanpa garis miring akhir)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (XAMPP/MariaDB) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aigen_db
DB_USER=root
DB_PASSWORD=
# Hanya dipakai bila DB_DRIVER=sqlite (test suite)
DB_PATH=

# --- Sesi ---
SESSION_NAME=aigen_session
SESSION_LIFETIME=0
# Kalau frontend beda domain dengan backend, wajib SESSION_SAMESITE=None
# DAN SESSION_SECURE=true (HTTPS), jika tidak cookie sesi akan ditolak browser.
SESSION_SAMESITE=Lax
SESSION_SECURE=false

# --- Keamanan ---
# Kunci enkripsi api_key vendor di tabel data_vendors. WAJIB diisi di produksi.
# Hasilkan dengan: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Token untuk memicu job lewat HTTP. Kosongkan agar job hanya bisa dari CLI.
JOB_TOKEN=

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
