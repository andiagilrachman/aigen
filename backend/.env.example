# =============================================================================
#  AIGen Backend — contoh konfigurasi environment
#  Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
# =============================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/aigen-backend
APP_TIMEZONE=Asia/Jakarta

# Asal frontend yang diizinkan CORS (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (XAMPP/MariaDB) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aigen_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Sesi ---
SESSION_NAME=aigen_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# --- Kunci enkripsi untuk api_key vendor di tabel data_vendors ---
# Hasilkan dengan: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# --- Rate limit autentikasi ---
AUTH_MAX_ATTEMPTS=5
AUTH_DECAY_SECONDS=900
